{
  "model_name": "Lyra",
  "version": "0.1.0",
  "vocab_size": 16384,
  "context_length": 1024,
  "hidden_size": 1024,
  "num_layers": 20,
  "num_attention_heads": 16,
  "num_kv_heads": 4,
  "head_dim": 64,
  "intermediate_size": 3072,
  "rope_theta": 10000.0,
  "rope_scaling": null,
  "norm_eps": 1e-6,
  "dropout": 0.0,
  "tie_embeddings": true,
  "dtype": "bfloat16",
  "gradient_checkpointing": true,
  "training": {
    "require_cuda": true,
    "tokenizer": "/content/drive/MyDrive/Lyra/tokenizer/tokenizer.json",
    "data": "/content/drive/MyDrive/Lyra/datasets/lyra_v01/train.jsonl",
    "validation": "/content/drive/MyDrive/Lyra/datasets/lyra_v01/validation.jsonl",
    "stage": "pretrain",
    "steps": 10000,
    "batch_size": 1,
    "grad_accum": 16,
    "lr": 0.0003,
    "warmup_steps": 500,
    "save_every": 100,
    "archive_every": 0,
    "eval_every": 100,
    "out": "/content/drive/MyDrive/Lyra/checkpoints",
    "seed": 17
  }
}
