{
  "model_name": "Lyra-Small",
  "version": "0.1.0-small",
  "vocab_size": 16384,
  "context_length": 512,
  "hidden_size": 512,
  "num_layers": 8,
  "num_attention_heads": 8,
  "num_kv_heads": 2,
  "head_dim": 64,
  "intermediate_size": 1344,
  "rope_theta": 10000.0,
  "rope_scaling": null,
  "norm_eps": 1e-6,
  "dropout": 0.0,
  "tie_embeddings": true,
  "dtype": "bfloat16",
  "gradient_checkpointing": true,
  "training": {
    "require_cuda": false,
    "tokenizer": "artifacts/tokenizer/tokenizer.json",
    "data": "data/processed/train.jsonl",
    "validation": "data/processed/validation.jsonl",
    "stage": "pretrain",
    "steps": 800,
    "batch_size": 4,
    "grad_accum": 4,
    "lr": 0.0003,
    "warmup_steps": 80,
    "save_every": 200,
    "archive_every": 400,
    "eval_every": 100,
    "out": "checkpoints/small_stage1",
    "seed": 17
  }
}
