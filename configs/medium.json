{
  "model_name": "Lyra-Medium",
  "version": "0.1.0-medium",
  "vocab_size": 16384,
  "context_length": 512,
  "hidden_size": 768,
  "num_layers": 12,
  "num_attention_heads": 12,
  "num_kv_heads": 3,
  "head_dim": 64,
  "intermediate_size": 2048,
  "rope_theta": 10000.0,
  "rope_scaling": null,
  "norm_eps": 1e-6,
  "dropout": 0.0,
  "tie_embeddings": true,
  "dtype": "bfloat16",
  "gradient_checkpointing": true,
  "training": {
    "require_cuda": false,
    "tokenizer": "artifacts/tokenizer_full.json",
    "data": "data/processed/train.jsonl",
    "validation": "data/processed/validation.jsonl",
    "stage": "pretrain",
    "steps": 4000,
    "batch_size": 4,
    "grad_accum": 4,
    "lr": 3e-4,
    "warmup_steps": 200,
    "save_every": 200,
    "archive_every": 800,
    "eval_every": 100,
    "out": "checkpoints/medium_stage1",
    "seed": 17
  }
}
