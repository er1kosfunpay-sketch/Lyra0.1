{
  "model_name": "Lyra",
  "version": "0.1.0-saturn-a10g",
  "vocab_size": 16384,
  "context_length": 1024,
  "hidden_size": 2048,
  "num_layers": 22,
  "num_attention_heads": 16,
  "num_kv_heads": 4,
  "head_dim": 128,
  "intermediate_size": 5632,
  "rope_theta": 10000.0,
  "rope_scaling": null,
  "norm_eps": 1e-6,
  "dropout": 0.0,
  "tie_embeddings": true,
  "dtype": "bfloat16",
  "gradient_checkpointing": true,
  "training": {
    "require_cuda": true,
    "tokenizer": "artifacts/tokenizer/tokenizer.json",
    "data": "data/processed/saturn_stage1/train.jsonl",
    "validation": "data/processed/saturn_stage1/validation.jsonl",
    "stage": "pretrain",
    "steps": 2500,
    "batch_size": 1,
    "grad_accum": 8,
    "lr": 0.0003,
    "warmup_steps": 100,
    "save_every": 100,
    "archive_every": 100,
    "eval_every": 250,
    "out": "checkpoints/stage1_a10g",
    "seed": 17
  }
}
