# Hugging Face Token (optional for public datasets)
HF_TOKEN=

# Weights & Biases (optional)
WANDB_API_KEY=
WANDB_ENABLED=false

# Model paths
MODEL_PATH=
DATASET_PATH=
CHECKPOINT_PATH=
OUTPUT_PATH=

# Training mode
MODE=from_scratch  # from_scratch, continued_pretraining, sft

# Device settings
DEVICE=cuda

# Sequence length
MAX_SEQ_LENGTH=4096

# Gradient accumulation
GRADIENT_ACCUMULATION_STEPS=16

# Batch size per GPU
PER_DEVICE_BATCH_SIZE=4